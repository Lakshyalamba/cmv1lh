          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "title": "Delivery Date"
          },
          "decision_cutoff_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Decision Cutoff Utc"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "dataset": {
            "type": "string",
            "const": "FUELHH",
            "title": "Dataset",
            "default": "FUELHH"
          },
          "fuel_type": {
            "type": "string",
            "const": "WIND",
            "title": "Fuel Type",
            "default": "WIND"
          },
          "actual_revision_policy": {
            "type": "string",
            "title": "Actual Revision Policy",
            "default": "Latest publication in the extracted historical snapshot"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "type": "array",
            "title": "Observations"
          }
        },
        "additionalProperties": false,
        "type": "object",
