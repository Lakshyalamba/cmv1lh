  "components": {
    "schemas": {
      "Accuracy": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_matched_observations"
            ],
            "title": "Status"
          },
          "observation_count": {
            "type": "integer",
            "title": "Observation Count"
          },
          "mae_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mae Mw",
            "description": "Mean absolute forecast-minus-actual error"
          },
          "rmse_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rmse Mw",
            "description": "Square root of mean squared forecast-minus-actual error"
          },
          "bias_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bias Mw",
            "description": "Signed mean forecast-minus-actual error; positive means overforecast"
          },
          "error_definition": {
            "type": "string",
            "const": "forecast_mw - actual_mw",
            "title": "Error Definition",
            "default": "forecast_mw - actual_mw"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "observation_count",
          "mae_mw",
          "rmse_mw",
          "bias_mw"
        ],
        "title": "Accuracy"
      },
      "ActualResponse": {
        "properties": {
          "unit": {
            "type": "string",
            "const": "MW",
            "title": "Unit",
            "default": "MW"
          },
          "timezone": {
            "type": "string",
            "const": "Europe/London",
            "title": "Timezone",
            "default": "Europe/London"
          },
          "cutoff_local": {
            "type": "string",
            "title": "Cutoff Local"
          },
          "forecast_resolution_minutes": {
            "type": "integer",
            "const": 60,
            "title": "Forecast Resolution Minutes",
            "default": 60
          },
          "actual_resolution_minutes": {
            "type": "integer",
            "const": 30,
            "title": "Actual Resolution Minutes",
            "default": 30
          },
          "comparison_basis": {
            "type": "string",
            "title": "Comparison Basis",
            "default": "Native hourly forecast point versus half-hour mean actual at equal startTime"
          },
          "analysis_mode": {
            "type": "string",
            "const": "retrospective_evaluation",
            "title": "Analysis Mode",
            "default": "retrospective_evaluation"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "decision_date": {
            "type": "string",
            "format": "date",
